---
import LibraryFirstPaint from '../components/LibraryFirstPaint.astro';
import ResultFirstPaint from '../components/ResultFirstPaint.astro';
import ReplayListFirstPaint from '../components/ReplayListFirstPaint.astro';
const resultEntry = Astro.url.pathname.startsWith('/result');
---

<!doctype html>
<html lang="ko" data-result-pending={resultEntry || undefined}>
  <head>
    <meta charset="UTF-8" />
    <style is:inline>
      html[data-result-pending] {
        background: #14131a;
      }
      html[data-result-pending] #app {
        visibility: hidden;
      }
      #result-entry {
        display: none;
      }
      html[data-result-pending] #result-entry {
        display: grid;
        place-content: center;
        position: fixed;
        inset: 0;
        padding: 24px;
        color: #e8e7f2;
        font:
          600 18px system-ui,
          sans-serif;
      }
      #result-entry .result-spinner {
        width: 42px;
        height: 42px;
        border: 3px solid #30404d;
        border-top-color: #51e4f5;
        border-radius: 50%;
        animation: result-spin 0.8s linear infinite;
      }
      @keyframes result-spin {
        to {
          transform: rotate(360deg);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #result-entry .result-spinner {
          animation: none;
        }
      }
    </style>
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="theme-color" content="#14131a" />
    <meta
      name="description"
      content="Orvio. A browser keyboard rhythm game with 4, 5, 6, 7 or 8 keys. Add YouTube-linked music to your browser library or play built-in original tracks."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={
        resultEntry ? 'Orvio result · score & replay' : 'orvio · find your flow'
      }
    />
    <meta
      property="og:description"
      content={
        resultEntry
          ? 'View the score, accuracy and combo. Watch the replay and play the track.'
          : 'Add YouTube-linked music to your browser library. Choose 4, 5, 6, 7 or 8 keys, with built-in original tracks also available.'
      }
    />
    <meta
      property="og:image"
      content={
        resultEntry
          ? 'https://orvio-play.pages.dev/og-result.png'
          : 'https://orvio-play.pages.dev/og-default.png'
      }
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{Astro.props.title || "orvio · find your flow"}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    {resultEntry && (
      <div id="result-entry" aria-hidden="true">
        <div class="result-spinner"></div>
      </div>
    )}
    {resultEntry && <ResultFirstPaint />}
    <LibraryFirstPaint />
    <ReplayListFirstPaint />
    <div id="app"></div>
    <script src="../general468-entry.ts"></script>
    <script>
      import { registerApp } from '../pwa';
      registerApp();
    </script>
  </body>
</html>
