---
import { LANGUAGES } from '../i18n';
import Layout from '../layouts/Layout.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#070d15" />
    <title>Status · orvio</title>
    <link rel="icon" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <main>
      <header>
        <h1 id="status-title">Status</h1>
        <div class="header-controls">
          <select id="status-language" aria-label="Language">
            {Object.entries(LANGUAGES).map(([key, name]) => (
              <option value={key}>{name}</option>
            ))}
          </select>
          <button id="status-refresh" type="button" aria-label="Refresh">
            Refresh
          </button>
        </div>
      </header>

      <section id="overall" aria-label="Overall status">
        <p class="overall-text" data-overall-text data-state="unknown">Checking…</p>
        <p class="overall-meta">
          <span data-overall-at>—</span>
        </p>
        <p class="overall-meta version">
          <span data-version>—</span>
        </p>
        <p class="overall-meta probe-note"><span data-probe-note></span></p>
      </section>

      <div class="cards">
        <section class="card" data-area="website">
          <h2 data-area-title>Website</h2>
          <div aria-live="polite" aria-atomic="true">
            <p class="state" data-state="unknown">Checking…</p>
            <p class="checked"><span data-checked-at>—</span></p>
            <p class="detail" data-detail></p>
          </div>
        </section>

        <section class="card" data-area="api">
          <h2 data-area-title>API</h2>
          <div aria-live="polite" aria-atomic="true">
            <p class="state" data-state="unknown">Checking…</p>
            <p class="checked"><span data-checked-at>—</span></p>
            <p class="detail" data-detail></p>
          </div>
        </section>

        <section class="card" data-area="provider">
          <h2 data-area-title>Transcription provider</h2>
          <div aria-live="polite" aria-atomic="true">
            <p class="state" data-state="unknown">Checking…</p>
            <p class="checked"><span data-checked-at>—</span></p>
            <p class="detail" data-detail></p>
          </div>
        </section>
      </div>
    </main>
    <script src="../status-page.ts"></script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #070d15;
    color: #efebf4;
    font: 16px Outfit, system-ui, sans-serif;
    line-height: 1.6;
  }
  main {
    max-width: 900px;
    margin: auto;
    padding: 32px 24px 80px;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  h1 {
    font-size: clamp(28px, 5vw, 44px);
    margin: 0;
  }
  h2 {
    font-size: 22px;
    margin: 0 0 8px;
  }
  .header-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  select,
  button {
    background: #15222c;
    color: #efebf4;
    border: 1px solid #ffffff19;
    border-radius: 8px;
    padding: 10px 16px;
    font: inherit;
  }
  select {
    max-width: 220px;
  }
  button {
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  a:focus-visible,
  select:focus-visible,
  button:focus-visible {
    outline: 2px solid #29d8ff;
    outline-offset: 4px;
  }

  #overall {
    background: #15222c;
    border: 1px solid #ffffff19;
    border-left-width: 6px;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
  }
  #overall:has([data-overall-text][data-state='healthy']) {
    border-left-color: #2ecc71;
    background: #10261b;
  }
  #overall:has([data-overall-text][data-state='degraded']) {
    border-left-color: #ffb020;
    background: #2a1f10;
  }
  #overall:has([data-overall-text][data-state='unknown']) {
    border-left-color: #7a8699;
    background: #15222c;
  }
  .overall-text {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 700;
  }
  .overall-meta {
    margin: 0;
    color: #b4bfca;
  }
  .overall-meta.version {
    margin-top: 4px;
    font-size: 14px;
  }

  .cards {
    display: grid;
    gap: 18px;
  }
  .card {
    background: #15222c;
    border: 1px solid #ffffff19;
    border-radius: 12px;
    padding: 24px;
    overflow-wrap: anywhere;
  }
  .state {
    font-weight: 700;
    margin: 0 0 4px;
  }
  .checked,
  .detail {
    margin: 0;
    color: #b4bfca;
  }
  .detail:empty {
    display: none;
  }

  [data-state='healthy'] {
    color: #8ee6bb;
  }
  [data-state='degraded'] {
    color: #ffba8c;
  }
  [data-state='unknown'] {
    color: #b4bfca;
  }
</style>
