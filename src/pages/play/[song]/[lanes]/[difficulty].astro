---
import Game from '../../../../layouts/Game.astro';
import { SONGS } from '../../../../chart';
export function getStaticPaths() {
  return SONGS.flatMap((song) =>
    ['5', '7'].flatMap((lanes) =>
      ['low', 'mid', 'high', 'sc'].map((difficulty) => ({
        params: { song: song.id, lanes, difficulty },
        props: { title: `${song.title} · ${lanes} KEY ${difficulty} · orvio` },
      })),
    ),
  );
}
---

<Game title={Astro.props.title} />
