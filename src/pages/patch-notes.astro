  @font-face {
    font-family: Outfit;
    src: url('/outfit.ttf');
  }
  @font-face {
    font-family: Noto;
    src: url('/korean.ttf');
  }
  @font-face {
    font-family: NotoSC;
    src: url('/chinese.ttf');
    font-display: swap;
  }
  @font-face {
    font-family: NotoJP;
    src: url('/japanese.ttf');
    font-display: swap;
  }
  [lang='zh'] {
    font-family: Outfit, NotoSC, system-ui, sans-serif;
  }
  [lang='ja'] {
    font-family: Outfit, NotoJP, system-ui, sans-serif;
  }
  body {
    margin: 0;
    background: #14131a;
    color: #eeedf2;
    font:
      16px Outfit,
      Noto,
      system-ui,
      sans-serif;
    line-height: 1.8;
    user-select: text;
    -webkit-user-select: text;
  }
  * {
    box-sizing: border-box;
  }
  main {
    max-width: 900px;
    margin: auto;
    padding: 32px 28px 90px;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 52px;
  }
  /* The enhanced select's shared default is full-width for form fields.
       Keep only this header language control compact. */
  header :global(.orvio-select) {
    flex: 0 1 180px;
    width: 180px;
    max-width: calc(100% - 129px);
    margin-left: auto;
  }
  header :global(.select-menu) {
    font-family: Outfit, Noto, NotoSC, NotoJP, system-ui, sans-serif;
  }
  header img {
    filter: invert(1);
  }
  select {
    max-width: 52%;
    background: #242333;
    color: #eeedf2;
    padding: 10px 12px;
    border: 1px solid #ffffff30;
    border-radius: 6px;
    font: inherit;
  }
  a {
    color: #29d8ff;
  }
  h1 {
    font-size: clamp(32px, 6vw, 54px);
    margin: 16px 0;
  }
  h2 {
    font-size: 24px;
    margin: 0;
  }
  article {
    padding: 30px 0;
    border-top: 1px solid #ffffff24;
  }
  .scope {
    color: #aaa5b8;
    margin-bottom: 42px;
  }
  .version {
    display: flex;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
  }
  time {
    font-size: 13px;
    color: #aaa5b8;
  }
  ul {
    padding-left: 22px;
  }
  li {
    margin: 12px 0;
    overflow-wrap: anywhere;
    word-break: keep-all;
  }
  [hidden] {
    display: none !important;
  }
  a:focus-visible,
  select:focus-visible {
    outline: 2px solid #29d8ff;
    outline-offset: 5px;
  }
  @media (max-width: 480px) {
    main {
      padding: 24px 20px 60px;
    }
    header {
      margin-bottom: 36px;
    }
    body {
      font-size: 15px;
    }
  }
</style>
