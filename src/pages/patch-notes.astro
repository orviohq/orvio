---
import '../scrollbars.css';
import { GROUP_LABELS, patchGroups } from '../patch-groups';
import { PATCHES, PATCH_LABELS } from '../patch-notes';
import { LANGUAGES, type Language } from '../i18n';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#14131a" />
    <meta name="description" content="Orvio release history in 13 languages." />
    <title>Patch notes · orvio</title>
    <link rel="icon" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <main>
      <header>
        <a href="/" aria-label="orvio home">
          <img src="/wordmark.svg" alt="orvio" width="105" />
        </a>
        <select id="patch-language" aria-label="Language">
          {Object.entries(LANGUAGES).map(([key, name]) => (
            <option value={key}>{name}</option>
          ))}
        </select>
      </header>
      {Object.entries(PATCH_LABELS).map(([lang, label]) => (
        <div data-language={lang} lang={lang} hidden={lang !== 'ko'}>
          <a class="back" href="/">
            ← {label.back}
          </a>
          <h1>{label.title}</h1>
          <p class="scope">{label.scope}</p>
          {PATCHES.map((p) => (
            <article id={`${lang}-${p.version}`}>
              <div class="version">
                <h2>v{p.version}</h2>
                <time datetime={p.date}>{p.date}</time>
              </div>
              {Object.entries(
                patchGroups(
                  p.version,
                  lang as Language,
                  p.notes[lang as Language],
                ),
              )
                .filter(([, notes]) => notes.length > 0)
                .map(([group, notes]) => (
                  <section data-patch-group={group}>
                    <h3>
                      {
                        GROUP_LABELS[lang as Language][
                          group as 'features' | 'fixes'
                        ]
                      }
                    </h3>
                    <ul>
                      {notes.map((text) => (
                        <li>{text}</li>
                      ))}
                    </ul>
                  </section>
                ))}
            </article>
          ))}
        </div>
      ))}
    </main>
    <script>
      import { LANGUAGES } from '../i18n';
      import { enhanceSelects } from '../select-ui';
      import '../select-ui.css';
      import { resolvedLanguage } from '../language';
      const select =
        document.querySelector<HTMLSelectElement>('#patch-language')!;
      function show(lang: string) {
        if (!(lang in LANGUAGES))
          lang = resolvedLanguage({}, navigator.languages);
        select.value = lang;
        document.documentElement.lang = lang;
        document
          .querySelectorAll<HTMLElement>('[data-language]')
          .forEach((el) => (el.hidden = el.dataset.language !== lang));
        history.replaceState(null, '', '?lang=' + lang);
      }
      const params = new URLSearchParams(location.search);
      let saved = {};
      try {
        saved = JSON.parse(localStorage.getItem('orvio.settings.v1') || '{}');
      } catch {}
      show(params.get('lang') || resolvedLanguage(saved, navigator.languages));
      select.onchange = () => show(select.value);
      enhanceSelects();
    </script>
    <script>
      import { registerApp } from '../pwa';
      registerApp();
    </script>
  </body>
</html>
