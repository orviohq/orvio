{
  "name": "orvio",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "tsc --noEmit && astro build",
    "test": "vitest run",
    "check": "prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "preview": "astro preview --host 0.0.0.0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "7.4.7",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
