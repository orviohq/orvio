{
  "name": "orvio",
  "version": "0.3.27",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "tsc --noEmit && astro build && node scripts/build-pwa.mjs",
    "test": "npm run test:youtube-direct && npm run test:allkeys-node && npm run test:youtube-origin && vitest run",
    "test:allkeys-node": "node --experimental-strip-types --test tests/direct-local-allkeys-store.test.ts tests/direct-local-allkeys-worker.test.ts",
    "test:youtube-direct": "node --experimental-transform-types --test tests/youtube-direct-api.test.ts",
    "test:youtube-origin": "node --experimental-transform-types --test tests/youtube-origin-config.test.ts",
    "check": "prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "preview": "astro preview --host 0.0.0.0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/query-persist-client-core": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "astro": "7.4.7",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "@noble/hashes": "2.0.1",
    "codec-parser": "2.5.0",
    "opus-decoder": "0.7.12"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
