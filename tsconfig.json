{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "server",
    "functions",
    "tests",
    "e2e",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
